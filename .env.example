# Copy this file to .env and fill in whatever you need to change.
# Every setting below also has a hardcoded default in model_config.py, and
# can additionally be overridden live from the Streamlit settings panel
# (which takes priority over this file). Leave a line commented out / blank
# to just use the default.

# --- Model selection ---
# LLM_PROVIDER=ollama              # ollama | openai | gemini
# LLM_MODEL=gpt-oss:120b-cloud
# LLM_TEMPERATURE=0.0
# EMBEDDING_PROVIDER=ollama        # ollama | openai
# EMBEDDING_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# --- Credentials (only needed if you switch LLM_PROVIDER/EMBEDDING_PROVIDER) ---
# OPENAI_API_KEY=sk-dummy-replace-with-your-own-key
# GOOGLE_API_KEY=dummy-replace-with-your-own-gemini-key

# --- YouTube transcript fetching (needed if fetch_transcripts gets blocked) ---
# YOUTUBE_COOKIES_PATH=secrets/cookies.txt
# WEBSHARE_PROXY_USERNAME=dummy-webshare-username
# WEBSHARE_PROXY_PASSWORD=dummy-webshare-password

# --- Chunking / retrieval ---
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# RETRIEVER_TOP_K=4

# --- Storage paths ---
# TRANSCRIPTS_DIR=transcripts
# CHROMA_PERSIST_DIR=chroma_db
# CHROMA_COLLECTION_NAME=youtube_transcripts
# SETTINGS_PATH=secrets/settings.json
# COOKIES_UPLOAD_PATH=secrets/cookies.txt

# --- App defaults ---
# Comma-separated YouTube video IDs or URLs to seed the app with on first run.
# DEFAULT_VIDEO_IDS=zjkBMFhNj_g
